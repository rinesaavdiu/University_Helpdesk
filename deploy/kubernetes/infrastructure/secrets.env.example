# Copy to secrets.env (git-ignored) and replace every change-me value.
# Use only letters and digits in passwords: they are inserted into connection strings.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=helpdesk
RABBITMQ_PASSWORD=change-me
# At least 32 characters; the API refuses to start otherwise.
JWT_SIGNING_KEY=change-me
DEMO_STUDENT1_PASSWORD=change-me
DEMO_STUDENT2_PASSWORD=change-me
DEMO_TECHNICIAN1_PASSWORD=change-me

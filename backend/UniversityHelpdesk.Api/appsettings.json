{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "UniversityHelpdesk.Api",
    "Audience": "UniversityHelpdesk.Clients"
  },
  "RabbitMq": {
    "HostName": "127.0.0.1",
    "Port": 55672,
    "VirtualHost": "helpdesk",
    "UserName": "helpdesk",
    "Exchange": "helpdesk.events",
    "TicketResolvedQueue": "helpdesk.ticket-resolved"
  },
  "Redis": {
    "Configuration": "127.0.0.1:56379",
    "CategoryCacheDuration": "00:05:00",
    "Timeout": "00:00:01"
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "127.0.0.1",
    "Port": 55672,
    "VirtualHost": "helpdesk",
    "UserName": "helpdesk",
    "Exchange": "helpdesk.events",
    "TicketResolvedQueue": "helpdesk.ticket-resolved",
    "FailedQueue": "helpdesk.ticket-resolved.failed"
  },
  "Smtp": {
    "Host": "127.0.0.1",
    "Port": 51025,
    "FromAddress": "helpdesk@uni.test",
    "FromName": "University Helpdesk"
  },
  "Delivery": {
    "MaxAttempts": 5,
    "FirstRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:00:30"
  }
}

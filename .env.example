# Copy this file to .env and replace every change-me value.
# Docker Compose reads .env automatically. Never commit .env.
# Use only letters and digits in passwords: they are inserted into connection strings.

POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=55432

RABBITMQ_USER=helpdesk
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST_PORT=55672
RABBITMQ_MANAGEMENT_HOST_PORT=55673

REDIS_HOST_PORT=56379
MAILPIT_SMTP_HOST_PORT=51025
MAILPIT_UI_HOST_PORT=58025

# API containers. The signing key must be at least 32 characters; the API refuses to start otherwise.
API_HOST_PORT=58080
JWT_SIGNING_KEY=change-me

# Passwords for the demo accounts created by the db-init service.
DEMO_STUDENT1_PASSWORD=change-me
DEMO_STUDENT2_PASSWORD=change-me
DEMO_TECHNICIAN1_PASSWORD=change-me
